<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>deepfolio. — Privacidad</title>
    <link rel="icon" type="logo" href="../../logo/logobien.png">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --burgundy-deep: #3D0F14;
            --burgundy-dark: #5C1A20;
            --burgundy: #7B2D35;
            --burgundy-mid: #8B3A42;
            --burgundy-light: #A84B52;
            --burgundy-pale: #C46B73;
            --gold: #C9A84C;
            --gold-light: #D4B96A;
            --gold-pale: #E8D5A0;
            --cream: #F5EDE4;
            --cream-light: #FAF6F2;
            --text-dark: #1A080A;
            --text-muted: #6B5055;
            --bg-dark: #1A0A0E;
            --bg-card: #2A1015;
            --bg-card-light: #35151A;
            --white: #FFFFFF;
            --success: #4A9E6E;
            --danger: #C45A5A;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: var(--cream);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); }
        ::-webkit-scrollbar-thumb { background: var(--burgundy); border-radius: 4px; }

        /* ===== NAVBAR ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: transparent;
        }

        .navbar.scrolled {
            background: rgba(26, 10, 14, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(123, 45, 53, 0.3);
            padding: 0.7rem 2rem;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .nav-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--burgundy), var(--gold));
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--white);
            font-family: 'Playfair Display', serif;
        }

        .nav-logo-icon span {
            color: black;            
        }   

        .nav-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--cream);
            letter-spacing: -0.5px;
        }

        .nav-logo-text span {
            color: var(--gold);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--cream);
            font-size: 0.9rem;
            font-weight: 500;
            opacity: 0.8;
            transition: all 0.3s;
            position: relative;
        }

        .nav-links a:hover {
            opacity: 1;
            color: var(--gold);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--gold);
            transition: width 0.3s;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-cta {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.7rem 1.5rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            font-family: 'Inter', sans-serif;
        }

        .btn-ghost {
            background: transparent;
            color: var(--cream);
            border: 1px solid rgba(201, 168, 76, 0.3);
        }

        .btn-ghost:hover {
            border-color: var(--gold);
            color: var(--gold);
            background: rgba(201, 168, 76, 0.05);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--burgundy), var(--burgundy-mid));
            color: var(--white);
            box-shadow: 0 4px 15px rgba(123, 45, 53, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(123, 45, 53, 0.5);
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: var(--text-dark);
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
        }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(201, 168, 76, 0.4);
        }

        .btn-large {
            padding: 1rem 2.2rem;
            font-size: 1rem;
            border-radius: 10px;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 5px;
        }

        .hamburger span {
            width: 25px;
            height: 2px;
            background: var(--cream);
            transition: all 0.3s;
            border-radius: 2px;
        }

                        /* ===== ANIMATED BACKGROUND ===== */
        .bg-layer {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
        }

        .bg-gradient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.4;
            animation: orbFloat 12s ease-in-out infinite alternate;
        }

        .bg-gradient-orb:nth-child(1) {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--burgundy-dark), transparent 70%);
            top: -10%;
            left: -10%;
            animation-duration: 15s;
        }

        .bg-gradient-orb:nth-child(2) {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--burgundy), transparent 70%);
            bottom: -15%;
            right: -5%;
            animation-duration: 18s;
            animation-delay: -3s;
        }

        .bg-gradient-orb:nth-child(3) {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(201, 168, 76, 0.15), transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-duration: 10s;
            animation-delay: -7s;
        }

        @keyframes orbFloat {
            0% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -20px) scale(1.05); }
            66% { transform: translate(-20px, 30px) scale(0.95); }
            100% { transform: translate(10px, -10px) scale(1.02); }
        }

        .bg-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(201, 168, 76, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(201, 168, 76, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        .bg-particles {
            position: absolute;
            inset: 0;
        }

        .bg-particle {
            position: absolute;
            width: 2px;
            height: 2px;
            background: var(--gold);
            border-radius: 50%;
            opacity: 0;
            animation: particleDrift 10s infinite;
        }

        @keyframes particleDrift {
            0% { opacity: 0; transform: translateY(100vh) translateX(0); }
            10% { opacity: 0.5; }
            90% { opacity: 0.5; }
            100% { opacity: 0; transform: translateY(-10vh) translateX(50px); }
        }


        /* LAYOUT */
        .privacy-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 10rem 2rem 4rem;
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 3rem;
        }

        /* HEADER */
        .privacy-header {
            grid-column: 1 / -1;
            margin-bottom: 1rem;
        }
        .privacy-badge {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.4rem 1rem;
            background: rgba(123, 45, 53, 0.2);
            border: 1px solid rgba(201, 168, 76, 0.2);
            border-radius: 50px;
            font-size: 0.8rem; color: var(--gold-pale);
            margin-bottom: 1.2rem;
        }
        .privacy-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.2rem, 4vw, 3.2rem);
            font-weight: 700; line-height: 1.15;
            margin-bottom: 1rem;
        }
        .privacy-subtitle {
            font-size: 1.1rem; color: var(--cream); opacity: 0.6;
            max-width: 650px; font-weight: 300;
        }
        .privacy-meta {
            margin-top: 1.5rem;
            display: flex; gap: 1.5rem; flex-wrap: wrap;
            font-size: 0.85rem; color: var(--cream); opacity: 0.5;
            font-family: 'JetBrains Mono', monospace;
        }

        /* TABLE OF CONTENTS */
        .toc {
            position: sticky;
            top: 6rem;
            height: fit-content;
            background: rgba(42, 16, 21, 0.4);
            border: 1px solid rgba(123, 45, 53, 0.2);
            border-radius: 12px;
            padding: 1.5rem;
        }
        .toc-title {
            font-family: 'Playfair Display', serif;
            font-size: 0.95rem; font-weight: 600;
            margin-bottom: 1rem; color: var(--gold);
            text-transform: uppercase; letter-spacing: 1px;
        }
        .toc-list {
            list-style: none;
            display: flex; flex-direction: column; gap: 0.3rem;
        }
        .toc-link {
            display: block;
            padding: 0.5rem 0.8rem;
            text-decoration: none;
            color: var(--cream); opacity: 0.6;
            font-size: 0.85rem;
            border-radius: 6px;
            border-left: 2px solid transparent;
            transition: all 0.3s;
        }
        .toc-link:hover { opacity: 1; background: rgba(123, 45, 53, 0.15); }
        .toc-link.active {
            opacity: 1;
            color: var(--gold);
            border-left-color: var(--gold);
            background: rgba(201, 168, 76, 0.08);
        }

        /* CONTENT */
        .privacy-content {
            max-width: 780px;
        }
        .privacy-section {
            margin-bottom: 3rem;
            padding-bottom: 2.5rem;
            border-bottom: 1px solid rgba(123, 45, 53, 0.15);
        }
        .privacy-section:last-child { border-bottom: none; }
        
        .privacy-section h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem; font-weight: 600;
            margin-bottom: 1.2rem;
            display: flex; align-items: center; gap: 0.8rem;
        }
        .privacy-section h2 .num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 32px; height: 32px;
            background: rgba(123, 45, 53, 0.25);
            border: 1px solid rgba(201, 168, 76, 0.2);
            border-radius: 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem; color: var(--gold);
            flex-shrink: 0;
        }

        .privacy-section p {
            margin-bottom: 1rem;
            font-size: 1.02rem;
            color: var(--cream);
            opacity: 0.85;
        }
        .privacy-section ul, .privacy-section ol {
            margin: 1rem 0 1.2rem 1.2rem;
            color: var(--cream);
            opacity: 0.85;
        }
        .privacy-section li {
            margin-bottom: 0.6rem;
            font-size: 1rem;
        }
        .privacy-section strong {
            color: var(--cream);
            opacity: 1;
            font-weight: 600;
        }
        .highlight-box {
            background: rgba(42, 16, 21, 0.6);
            border: 1px solid rgba(123, 45, 53, 0.25);
            border-left: 3px solid var(--gold);
            border-radius: 8px;
            padding: 1.2rem 1.5rem;
            margin: 1.5rem 0;
            font-size: 0.95rem;
        }

        /* ===== FOOTER ===== */
        .footer {
            background: rgba(26, 10, 14, 0.95);
            border-top: 1px solid rgba(123, 45, 53, 0.2);
            padding: 4rem 2rem 2rem;
        }

        .footer-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .footer-brand p {
            font-size: 0.9rem;
            color: var(--cream);
            opacity: 0.5;
            line-height: 1.7;
            margin-top: 1rem;
            max-width: 300px;
        }

        .footer-col h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
            color: var(--cream);
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .footer-col ul a {
            text-decoration: none;
            color: var(--cream);
            opacity: 0.5;
            font-size: 0.85rem;
            transition: all 0.3s;
        }

        .footer-col ul a:hover {
            opacity: 1;
            color: var(--gold);
        }
        
                .footer-col:nth-child(2) { 
    margin-left: 500px; /* Ajusta este número a tu gusto */
}


.footer-col:nth-child(2) { 
    margin-left: auto; /* Esto empuja Recursos y Empresa al extremo derecho */
    padding-right: 50px; /* Para que no peguen al borde de la pantalla */
}

        .footer-col li a {
    white-space: nowrap; /* Evita que el texto salte a 2 líneas */
}

        .footer-bottom {
            max-width: 1200px;
            margin: 0 auto;
            padding-top: 2rem;
            border-top: 1px solid rgba(123, 45, 53, 0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-bottom p {
            font-size: 0.8rem;
            color: var(--cream);
            opacity: 0.3;
        }

        .footer-socials {
            display: flex;
            gap: 1rem;
        }

        .footer-socials a {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid rgba(123, 45, 53, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s;
            color: var(--cream);
            opacity: 0.5;
        }

        .footer-socials a:hover {
            border-color: var(--gold);
            opacity: 1;
            background: rgba(201, 168, 76, 0.1);
        }


        /* RESPONSIVE */
        @media (max-width: 900px) {
            .privacy-wrapper {
                grid-template-columns: 1fr;
                padding-top: 6rem;
            }
            .toc {
                position: relative;
                top: 0;
                margin-bottom: 2rem;
            }
            .toc-list {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 0.5rem;
            }
        }
        @media (max-width: 600px) {
            .privacy-wrapper { padding: 5rem 1.2rem 3rem; }
            .privacy-title { font-size: 2rem; }
            .toc-list { grid-template-columns: 1fr; }
            .privacy-meta { flex-direction: column; gap: 0.5rem; }
        }
    </style>
</head>
