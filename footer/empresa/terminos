<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>deepfolio. — Términos</title>
     <link rel="icon" type="logo" href="../../logo/logobien.png">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --burgundy-deep: #3D0F14;
            --burgundy-dark: #5C1A20;
            --burgundy: #7B2D35;
            --burgundy-mid: #8B3A42;
            --burgundy-light: #A84B52;
            --burgundy-pale: #C46B73;
            --gold: #C9A84C;
            --gold-light: #D4B96A;
            --gold-pale: #E8D5A0;
            --cream: #F5EDE4;
            --cream-light: #FAF6F2;
            --text-dark: #1A080A;
            --text-muted: #6B5055;
            --bg-dark: #1A0A0E;
            --bg-card: #2A1015;
            --bg-card-light: #35151A;
            --white: #FFFFFF;
            --success: #4A9E6E;
            --danger: #C45A5A;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: var(--cream);
            overflow-x: hidden;
            line-height: 1.7;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); }
        ::-webkit-scrollbar-thumb { background: var(--burgundy); border-radius: 3px; }

        /* ===== NAVBAR ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: transparent;
        }

        .navbar.scrolled {
            background: rgba(26, 10, 14, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(123, 45, 53, 0.3);
            padding: 0.7rem 2rem;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .nav-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--burgundy), var(--gold));
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--white);
            font-family: 'Playfair Display', serif;
        }

        .nav-logo-icon span {
            color: black;            
        }   

        .nav-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--cream);
            letter-spacing: -0.5px;
        }

        .nav-logo-text span {
            color: var(--gold);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--cream);
            font-size: 0.9rem;
            font-weight: 500;
            opacity: 0.8;
            transition: all 0.3s;
            position: relative;
        }

        .nav-links a:hover {
            opacity: 1;
            color: var(--gold);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--gold);
            transition: width 0.3s;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-cta {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.7rem 1.5rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            font-family: 'Inter', sans-serif;
        }

        .btn-ghost {
            background: transparent;
            color: var(--cream);
            border: 1px solid rgba(201, 168, 76, 0.3);
        }

        .btn-ghost:hover {
            border-color: var(--gold);
            color: var(--gold);
            background: rgba(201, 168, 76, 0.05);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--burgundy), var(--burgundy-mid));
            color: var(--white);
            box-shadow: 0 4px 15px rgba(123, 45, 53, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(123, 45, 53, 0.5);
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: var(--text-dark);
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
        }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(201, 168, 76, 0.4);
        }

        .btn-large {
            padding: 1rem 2.2rem;
            font-size: 1rem;
            border-radius: 10px;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 5px;
        }

        .hamburger span {
            width: 25px;
            height: 2px;
            background: var(--cream);
            transition: all 0.3s;
            border-radius: 2px;
        }

        /* ===== HERO / HEADER ===== */
        .terms-header {
            min-height: 30vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 8rem 2rem 3rem;
            overflow: hidden;
        }

        .terms-header-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
        }

        .terms-header-bg::before {
            content: '';
            position: absolute;
            top: -30%;
            left: -30%;
            width: 160%;
            height: 160%;
            background: radial-gradient(ellipse at 40% 30%, rgba(123, 45, 53, 0.12) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 70%, rgba(201, 168, 76, 0.04) 0%, transparent 50%);
        }

        .terms-header-content {
            position: relative;
            z-index: 1;
            text-align: center;
            max-width: 700px;
        }

        .terms-version {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 1rem;
            background: rgba(123, 45, 53, 0.15);
            border: 1px solid rgba(201, 168, 76, 0.15);
            border-radius: 50px;
            font-size: 0.78rem;
            color: var(--gold-pale);
            margin-bottom: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .terms-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 0.5rem;
        }

        .terms-title .gold {
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .terms-subtitle {
            font-size: 1.05rem;
            color: var(--cream);
            opacity: 0.5;
            font-weight: 300;
            line-height: 1.7;
            max-width: 520px;
            margin: 0 auto;
        }

        .terms-last-updated {
            margin-top: 0.75rem;
            font-size: 0.82rem;
            color: var(--cream);
            opacity: 0.35;
            font-family: 'JetBrains Mono', monospace;
        }

        /* ===== LAYOUT ===== */
        .terms-body {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem 6rem;
            display: grid;
            grid-template-columns: 240px 1fr;
            gap: 3rem;
            position: relative;
        }

        /* ===== SIDEBAR TOC ===== */
        .toc {
            position: sticky;
            top: 100px;
            height: fit-content;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            padding-right: 1rem;
        }

        .toc::-webkit-scrollbar { width: 3px; }
        .toc::-webkit-scrollbar-thumb { background: var(--burgundy); border-radius: 3px; }

        .toc-title {
            font-family: 'Playfair Display', serif;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--gold);
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(201, 168, 76, 0.2);
        }

        .toc-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .toc-item {
            display: block;
        }

        .toc-link {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            color: var(--cream);
            opacity: 0.4;
            font-size: 0.82rem;
            padding: 0.5rem 0.75rem;
            border-radius: 8px;
            transition: all 0.3s;
            border-left: 2px solid transparent;
        }

        .toc-link:hover {
            opacity: 0.8;
            background: rgba(123, 45, 53, 0.1);
        }

        .toc-link.active {
            opacity: 1;
            color: var(--gold);
            background: rgba(201, 168, 76, 0.05);
            border-left-color: var(--gold);
        }

        .toc-number {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            font-weight: 500;
            min-width: 20px;
        }

        .toc-text {
            line-height: 1.4;
        }

        /* ===== CONTENT ===== */
        .terms-content {
            min-width: 0;
        }

        .terms-section {
            margin-bottom: 1.5rem;
            scroll-margin-top: 100px;
        }

        .terms-section-header {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.5rem;
            background: rgba(42, 16, 21, 0.4);
            border: 1px solid rgba(123, 45, 53, 0.15);
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
            position: relative;
            overflow: hidden;
        }

        .terms-section-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .terms-section-header:hover {
            border-color: rgba(123, 45, 53, 0.35);
            background: rgba(42, 16, 21, 0.6);
        }

        .terms-section-header.active {
            border-color: rgba(201, 168, 76, 0.25);
            background: rgba(42, 16, 21, 0.7);
            border-radius: 14px 14px 0 0;
        }

        .terms-section-header.active::before {
            opacity: 1;
        }

        .section-number {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--gold);
            opacity: 0.3;
            line-height: 1;
            min-width: 40px;
            transition: opacity 0.3s;
        }

        .terms-section-header:hover .section-number {
            opacity: 0.5;
        }

        .terms-section-header.active .section-number {
            opacity: 0.8;
        }

        .section-header-text {
            flex: 1;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
            transition: color 0.3s;
        }

        .terms-section-header:hover .section-title {
            color: var(--gold-pale);
        }

        .section-brief {
            font-size: 0.82rem;
            color: var(--cream);
            opacity: 0.35;
            font-weight: 300;
        }

        .section-toggle {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid rgba(123, 45, 53, 0.2);
            background: transparent;
            color: var(--cream);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            flex-shrink: 0;
            margin-top: 0.25rem;
        }

        .section-toggle svg {
            width: 14px;
            height: 14px;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .terms-section-header.active .section-toggle {
            background: rgba(201, 168, 76, 0.1);
            border-color: var(--gold);
            color: var(--gold);
        }

        .terms-section-header.active .section-toggle svg {
            transform: rotate(180deg);
        }

        /* ===== EXPANDABLE CONTENT ===== */
        .terms-section-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .terms-section-body.open {
            max-height: 2000px;
        }

        .terms-section-inner {
            padding: 1.5rem 1.5rem 1.5rem;
            background: rgba(42, 16, 21, 0.3);
            border: 1px solid rgba(123, 45, 53, 0.15);
            border-top: none;
            border-radius: 0 0 14px 14px;
        }

        .terms-section-inner p {
            font-size: 0.92rem;
            color: var(--cream);
            opacity: 0.7;
            line-height: 1.8;
            margin-bottom: 1rem;
        }

        .terms-section-inner p:last-child {
            margin-bottom: 0;
        }

        .terms-section-inner ul {
            list-style: none;
            margin: 0.75rem 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .terms-section-inner ul li {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
            font-size: 0.9rem;
            color: var(--cream);
            opacity: 0.65;
            line-height: 1.6;
        }

        .terms-section-inner ul li::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--gold);
            border-radius: 2px;
            flex-shrink: 0;
            margin-top: 0.55rem;
            opacity: 0.6;
        }

        .terms-highlight {
            background: rgba(201, 168, 76, 0.06);
            border-left: 3px solid var(--gold);
            padding: 1rem 1.25rem;
            border-radius: 0 10px 10px 0;
            margin: 1rem 0;
        }

        .terms-highlight p {
            opacity: 0.8 !important;
            font-size: 0.88rem !important;
            margin-bottom: 0 !important;
        }

        .terms-highlight .highlight-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--gold);
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
        }

        .terms-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            font-size: 0.85rem;
        }

        .terms-table th {
            text-align: left;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold);
            font-weight: 500;
            border-bottom: 1px solid rgba(123, 45, 53, 0.3);
            opacity: 0.7;
        }

        .terms-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid rgba(123, 45, 53, 0.1);
            color: var(--cream);
            opacity: 0.65;
        }

        .terms-table tr:last-child td {
            border-bottom: none;
        }

        .terms-table .price-free {
            color: var(--success);
            opacity: 1;
            font-weight: 500;
        }

        .terms-table .price-paid {
            color: var(--gold);
            opacity: 1;
            font-weight: 500;
        }

        /* ===== CONTACT BAR ===== */
        .terms-contact {
            max-width: 1200px;
            margin: 0 auto 4rem;
            padding: 0 2rem;
        }

        .terms-contact-inner {
            background: linear-gradient(135deg, rgba(42, 16, 21, 0.8), rgba(61, 15, 20, 0.6));
            border: 1px solid rgba(201, 168, 76, 0.2);
            border-radius: 16px;
            padding: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            position: relative;
            overflow: hidden;
        }

        .terms-contact-inner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .terms-contact-text h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .terms-contact-text p {
            font-size: 0.9rem;
            color: var(--cream);
            opacity: 0.5;
        }

        .terms-contact-text a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.3s;
        }

        .terms-contact-text a:hover {
            opacity: 0.8;
        }

        .btn-contact {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.8rem 1.8rem;
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.3s;
            flex-shrink: 0;
            border: none;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        .btn-contact:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(201, 168, 76, 0.3);
        }

        /* ===== FOOTER ===== */
        .footer {
            background: rgba(26, 10, 14, 0.95);
            border-top: 1px solid rgba(123, 45, 53, 0.2);
            padding: 4rem 2rem 2rem;
        }

        .footer-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .footer-brand p {
            font-size: 0.9rem;
            color: var(--cream);
            opacity: 0.5;
            line-height: 1.7;
            margin-top: 1rem;
            max-width: 300px;
        }

        .footer-col h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
            color: var(--cream);
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .footer-col ul a {
            text-decoration: none;
            color: var(--cream);
            opacity: 0.5;
            font-size: 0.85rem;
            transition: all 0.3s;
        }

        .footer-col ul a:hover {
            opacity: 1;
            color: var(--gold);
        }
        
                .footer-col:nth-child(2) { 
    margin-left: 500px; /* Ajusta este número a tu gusto */
}


.footer-col:nth-child(2) { 
    margin-left: auto; /* Esto empuja Recursos y Empresa al extremo derecho */
    padding-right: 50px; /* Para que no peguen al borde de la pantalla */
}

        .footer-col li a {
    white-space: nowrap; /* Evita que el texto salte a 2 líneas */
}

        .footer-bottom {
            max-width: 1200px;
            margin: 0 auto;
            padding-top: 2rem;
            border-top: 1px solid rgba(123, 45, 53, 0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-bottom p {
            font-size: 0.8rem;
            color: var(--cream);
            opacity: 0.3;
        }

        .footer-socials {
            display: flex;
            gap: 1rem;
        }

        .footer-socials a {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid rgba(123, 45, 53, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s;
            color: var(--cream);
            opacity: 0.5;
        }

        .footer-socials a:hover {
            border-color: var(--gold);
            opacity: 1;
            background: rgba(201, 168, 76, 0.1);
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 900px) {
            .terms-body {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .toc {
                position: relative;
                top: 0;
                max-height: none;
                padding-right: 0;
                margin-bottom: 2rem;
                padding: 1.5rem;
                background: rgba(42, 16, 21, 0.4);
                border: 1px solid rgba(123, 45, 53, 0.2);
                border-radius: 14px;
            }

            .toc-list {
                flex-wrap: wrap;
                gap: 0.2rem;
            }

            .toc-link {
                padding: 0.4rem 0.6rem;
            }

            .terms-contact-inner {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (max-width: 600px) {
            .terms-header {
                min-height: 45vh;
                padding: 7rem 1.5rem 3rem;
            }

            .terms-body {
                padding: 0 1rem 4rem;
            }

            .terms-section-header {
                padding: 1.2rem;
            }

            .section-number {
                font-size: 1.4rem;
                min-width: 30px;
            }

            .section-title {
                font-size: 1rem;
            }

            .toc-list {
                flex-direction: column;
            }
        }

                /* ===== ANIMATED BACKGROUND ===== */
        .bg-layer {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
        }

        .bg-gradient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.4;
            animation: orbFloat 12s ease-in-out infinite alternate;
        }

        .bg-gradient-orb:nth-child(1) {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--burgundy-dark), transparent 70%);
            top: -10%;
            left: -10%;
            animation-duration: 15s;
        }

        .bg-gradient-orb:nth-child(2) {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--burgundy), transparent 70%);
            bottom: -15%;
            right: -5%;
            animation-duration: 18s;
