            // ===== NAVBAR SCROLL =====
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
        });

        // ===== ACCORDION =====
        function toggleSection(header) {
            const body = header.nextElementSibling;
            const isOpen = body.classList.contains('open');

            // Close all
            document.querySelectorAll('.terms-section-body').forEach(b => b.classList.remove('open'));
            document.querySelectorAll('.terms-section-header').forEach(h => h.classList.remove('active'));

            // Toggle current
            if (!isOpen) {
                body.classList.add('open');
                header.classList.add('active');
            }
        }

        // ===== TOC ACTIVE STATE =====
        const tocLinks = document.querySelectorAll('.toc-link');
        const sections = document.querySelectorAll('.terms-section');

        const tocObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');
                    tocLinks.forEach(link => {
                        link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                    });
                }
            });
        }, {
            rootMargin: '-20% 0px -60% 0px',
            threshold: 0
        });

        sections.forEach(section => tocObserver.observe(section));

        // ===== SMOOTH SCROLL FOR TOC =====
        tocLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = link.getAttribute('href').substring(1);
                const target = document.getElementById(targetId);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });

                    // Open the section if closed
                    const header = target.querySelector('.terms-section-header');
                    const body = target.querySelector('.terms-section-body');
                    if (!body.classList.contains('open')) {
                        body.classList.add('open');
                        header.classList.add('active');
                    }
                }
            });
        });

        // ===== OPEN FIRST SECTION BY DEFAULT =====
        window.addEventListener('load', () => {
            const firstHeader = document.querySelector('.terms-section:first-child .terms-section-header');
            const firstBody = document.querySelector('.terms-section:first-child .terms-section-body');
            if (firstHeader && firstBody) {
                firstHeader.classList.add('active');
                firstBody.classList.add('open');
            }
        });

        const particlesContainer = document.getElementById('bgParticles');

for (let i = 0; i < 25; i++) {
    const p = document.createElement('div');
    p.className = 'bg-particle';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDelay = Math.random() * 10 + 's';
    p.style.animationDuration = (8 + Math.random() * 8) + 's';

    particlesContainer.appendChild(p);
}
    </script>
