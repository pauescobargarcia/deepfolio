    <script>
        // ===== NAVBAR SCROLL =====
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
        });

        // ===== STATE =====
        let currentTier = 'lean';
        let yearlyData = [];

        // ===== FORMAT =====
        function formatCurrency(n) {
            if (n >= 1000000) return '€' + (n / 1000000).toFixed(1) + 'M';
            if (n >= 1000) return '€' + n.toLocaleString('es-ES', { maximumFractionDigits: 0 });
            return '€' + n.toFixed(0);
        }

        function formatCurrencyFull(n) {
            return '€' + n.toLocaleString('es-ES', { maximumFractionDigits: 0 });
        }

        // ===== SELECT TIER =====
        function selectTier(el) {
            document.querySelectorAll('.fire-tier').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            currentTier = el.dataset.tier;
            updateCalc();
        }

        // ===== MAIN CALCULATION =====
        function updateCalc() {
            const currentAge = parseInt(document.getElementById('currentAge').value);
            const retireAge = parseInt(document.getElementById('retireAge').value);
            const currentSavings = parseInt(document.getElementById('currentSavings').value);
            const annualSavings = parseInt(document.getElementById('annualSavings').value);
            const annualExpenses = parseInt(document.getElementById('annualExpenses').value);
            const expectedReturn = parseFloat(document.getElementById('expectedReturn').value) / 100;
            const inflation = parseFloat(document.getElementById('inflation').value) / 100;
            const withdrawalRate = parseFloat(document.getElementById('withdrawalRate').value) / 100;
            const annualSalary = parseInt(document.getElementById('annualSalary').value);

            // Update displays
            document.getElementById('ageDisplay').textContent = currentAge + ' años';
            document.getElementById('retireAgeDisplay').textContent = retireAge + ' años';
            document.getElementById('savingsDisplay').textContent = formatCurrencyFull(currentSavings);
            document.getElementById('annualSavingsDisplay').textContent = formatCurrencyFull(annualSavings);
            document.getElementById('expensesDisplay').textContent = formatCurrencyFull(annualExpenses);
            document.getElementById('returnDisplay').textContent = (expectedReturn * 100).toFixed(1) + '%';
            document.getElementById('inflationDisplay').textContent = (inflation * 100).toFixed(1) + '%';
            document.getElementById('withdrawalDisplay').textContent = (withdrawalRate * 100).toFixed(1) + '%';
            document.getElementById('salaryDisplay').textContent = formatCurrencyFull(annualSalary);

            // FIRE Number = Annual Expenses / Withdrawal Rate
            const fireNumber = annualExpenses / withdrawalRate;

            // Update tier amounts
            document.getElementById('leanAmount').textContent = formatCurrency(fireNumber * 0.5);
            document.getElementById('safeAmount').textContent = formatCurrency(fireNumber);
            document.getElementById('fatAmount').textContent = formatCurrency(fireNumber * 2);
            document.getElementById('baristaAmount').textContent = formatCurrency(fireNumber * 0.3);

            // Real return
            const realReturn = ((1 + expectedReturn) / (1 + inflation) - 1);

            // Savings rate
            const savingsRate = annualSalary > 0 ? (annualSavings / annualSalary) : 0;

            // Monthly values
            const monthlySavings = annualSavings / 12;
            const monthlyWithdrawal = annualExpenses / 12;

            // Years to FIRE (iterative calculation)
            yearlyData = [];
            let balance = currentSavings;
            let totalContributed = currentSavings;
            let fireReached = false;
            let fireYear = -1;
            const maxYears = retireAge - currentAge + 30; // safety buffer

            for (let year = 1; year <= maxYears; year++) {
                const age = currentAge + year;
                const contribution = annualSavings;
                const returnAmount = balance * expectedReturn;
                balance = balance + contribution + returnAmount;
                totalContributed += contribution;
                const interest = balance - totalContributed;
                const firePercent = Math.min((balance / fireNumber) * 100, 999);

                yearlyData.push({
                    year, age, contribution, returnAmount,
                    balance, totalContributed, interest,
                    firePercent, isFireYear: false
                });

                if (!fireReached && balance >= fireNumber) {
                    fireReached = true;
                    fireYear = year;
                    yearlyData[yearlyData.length - 1].isFireYear = true;
                }
            }

            const yearsToFIRE = fireReached ? fireYear : (currentAge + maxYears > retireAge ? 'No alcanzado' : '30+');
            const fireAgeVal = fireReached ? (currentAge + fireYear).toFixed(1) : '—';
            const progress = Math.min((currentSavings / fireNumber) * 100, 100);
            const totalContributionsAtFire = fireReached ? yearlyData[fireYear - 1]?.totalContributed : totalContributed;
            const totalInterestAtFire = fireReached ? yearlyData[fireYear - 1]?.interest : interest;

            // Update results
            document.getElementById('fireNumber').textContent = formatCurrencyFull(fireNumber);
            document.getElementById('fireNumberSub').textContent = `Patrimonio necesario para retirar ${formatCurrencyFull(annualExpenses)}/año`;
            document.getElementById('fireProgress').textContent = progress.toFixed(1) + '%';
            document.getElementById('fireProgressBar').style.width = progress + '%';
            document.getElementById('yearsToFIRE').textContent = typeof yearsToFIRE === 'number' ? yearsToFIRE.toFixed(1) : yearsToFIRE;
            document.getElementById('fireAge').textContent = fireAgeVal;
            document.getElementById('monthlySavings').textContent = formatCurrency(monthlySavings);
            document.getElementById('savingsRate').textContent = (savingsRate * 100).toFixed(0) + '%';
            document.getElementById('monthlyWithdrawal').textContent = formatCurrency(monthlyWithdrawal);
            document.getElementById('realReturn').textContent = (realReturn * 100).toFixed(1) + '%';
            document.getElementById('totalContributions').textContent = formatCurrency(totalContributionsAtFire);
            document.getElementById('totalInterest').textContent = formatCurrency(totalInterestAtFire);

            // Rule of 25 and 33
            document.getElementById('rule25').textContent = '25x';
            document.getElementById('rule33').textContent = '33x';

            // Fire status message
            const statusEl = document.getElementById('fireStatus');
            if (fireReached) {
                statusEl.style.borderColor = 'rgba(74, 158, 110, 0.3)';
                statusEl.style.background = 'rgba(74, 158, 110, 0.08)';
                statusEl.innerHTML = `✅ <strong>¡Alcanzable!</strong> Podrías llegar al FIRE en <strong>${fireYear} años</strong> (edad ${currentAge + fireYear})`;
            } else {
                statusEl.style.borderColor = 'rgba(196, 90, 90, 0.3)';
                statusEl.style.background = 'rgba(196, 90, 90, 0.08)';
                statusEl.innerHTML = `⚠️ <strong>Revisión necesaria</strong> — Con la tasa actual no alcanzarías el FIRE antes de los 75. Aumenta tu ahorro o reduce gastos.`;
            }

            // Milestones
            const milestones = [
                { id: 'ms1', val: 10000 },
                { id: 'ms2', val: 50000 },
                { id: 'ms3', val: 100000 },
                { id: 'ms4', val: 250000 },
                { id: 'ms5', val: 500000 },
                { id: 'ms6', val: 1000000 }
            ];
            milestones.forEach(m => {
                const el = document.getElementById(m.id);
                const achieved = balance >= m.val;
                el.className = 'milestone ' + (achieved ? 'achieved' : 'pending');
                el.textContent = (achieved ? '✓ ' : '○ ') + formatCurrency(m.val);
            });

            // Update chart
            drawFireChart(fireNumber);

            // Update yearly table
            updateYearlyTable();
        }

        // ===== DRAW CHART =====
        function drawFireChart(fireNumber) {
            const canvas = document.getElementById('fireChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            ctx.scale(dpr, dpr);

            const w = rect.width;
            const h = rect.height;
            const pad = { top: 30, right: 30, bottom: 40, left: 70 };
            const chartW = w - pad.left - pad.right;
            const chartH = h - pad.top - pad.bottom;

            // Data
            const data = yearlyData;
            if (data.length === 0) return;

            const maxVal = Math.max(...data.map(d => d.balance), fireNumber) * 1.1;
            const minVal = 0;

            function getX(i) { return pad.left + (i / (data.length - 1)) * chartW; }
            function getY(v) { return pad.top + chartH - ((v - minVal) / (maxVal - minVal)) * chartH; }

            // Grid
            ctx.strokeStyle = 'rgba(123, 45, 53, 0.1)';
            ctx.lineWidth = 0.5;
            const gridLines = 5;
            for (let i = 0; i <= gridLines; i++) {
                const y = pad.top + (i / gridLines) * chartH;
                ctx.beginPath();
                ctx.moveTo(pad.left, y);
                ctx.lineTo(w - pad.right, y);
                ctx.stroke();

                // Y labels
                const val = maxVal - (i / gridLines) * (maxVal - minVal);
                ctx.fillStyle = 'rgba(245, 237, 228, 0.3)';
                ctx.font = '11px JetBrains Mono, monospace';
                ctx.textAlign = 'right';
                ctx.fillText(formatCurrency(val), pad.left - 8, y + 4);
            }

            // X labels
            ctx.textAlign = 'center';
            const step = Math.max(1, Math.floor(data.length / 10));
            for (let i = 0; i < data.length; i += step) {
                ctx.fillStyle = 'rgba(245, 237, 228, 0.3)';
                ctx.fillText('Año ' + data[i].year, getX(i), h - pad.bottom + 20);
            }

            // FIRE line
            const fireY = getY(fireNumber);
            ctx.strokeStyle = 'rgba(201, 168, 76, 0.3)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([8, 4]);
            ctx.beginPath();
            ctx.moveTo(pad.left, fireY);
            ctx.lineTo(w - pad.right, fireY);
            ctx.stroke();
            ctx.setLineDash([]);

            // FIRE label
            ctx.fillStyle = 'rgba(201, 168, 76, 0.6)';
            ctx.font = '11px Inter, sans-serif';
            ctx.textAlign = 'left';
            ctx.fillText('🎯 Número FIRE: ' + formatCurrency(fireNumber), pad.left + 5, fireY - 8);

            // Interest area (between balance and contributions)
            ctx.beginPath();
            ctx.moveTo(getX(0), getY(data[0].totalContributed));
            for (let i = 1; i < data.length; i++) {
                ctx.lineTo(getX(i), getY(data[i].totalContributed));
            }
            for (let i = data.length - 1; i >= 0; i--) {
                ctx.lineTo(getX(i), getY(data[i].balance));
            }
            ctx.closePath();
            const interestGrad = ctx.createLinearGradient(0, pad.top, 0, pad.top + chartH);
            interestGrad.addColorStop(0, 'rgba(74, 158, 110, 0.15)');
            interestGrad.addColorStop(1, 'rgba(74, 158, 110, 0.02)');
            ctx.fillStyle = interestGrad;
            ctx.fill();

            // Contributions area
            ctx.beginPath();
            ctx.moveTo(getX(0), getY(0));
            for (let i = 0; i < data.length; i++) {
                ctx.lineTo(getX(i), getY(data[i].totalContributed));
            }
            ctx.lineTo(getX(data.length - 1), getY(0));
            ctx.closePath();
            const contribGrad = ctx.createLinearGradient(0, pad.top, 0, pad.top + chartH);
            contribGrad.addColorStop(0, 'rgba(123, 45, 53, 0.3)');
            contribGrad.addColorStop(1, 'rgba(123, 45, 53, 0.05)');
            ctx.fillStyle = contribGrad;
            ctx.fill();

            // Balance line
            ctx.beginPath();
            for (let i = 0; i < data.length; i++) {
                if (i === 0) ctx.moveTo(getX(i), getY(data[i].balance));
                else {
                    const cx = (getX(i - 1) + getX(i)) / 2;
                    ctx.bezierCurveTo(cx, getY(data[i - 1].balance), cx, getY(data[i].balance), getX(i), getY(data[i].balance));
                }
            }
            ctx.strokeStyle = 'rgba(201, 168, 76, 0.9)';
            ctx.lineWidth = 2.5;
            ctx.stroke();

            // Contributions line
            ctx.beginPath();
            for (let i = 0; i < data.length; i++) {
                if (i === 0) ctx.moveTo(getX(i), getY(data[i].totalContributed));
                else {
                    const cx = (getX(i - 1) + getX(i)) / 2;
                    ctx.bezierCurveTo(cx, getY(data[i - 1].totalContributed), cx, getY(data[i].totalContributed), getX(i), getY(data[i].totalContributed));
                }
            }
            ctx.strokeStyle = 'rgba(123, 45, 53, 0.6)';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // FIRE year marker
            const fireYearIdx = data.findIndex(d => d.isFireYear);
            if (fireYearIdx >= 0) {
                const fx = getX(fireYearIdx);
                const fy = getY(data[fireYearIdx].balance);

                // Vertical line
                ctx.strokeStyle = 'rgba(201, 168, 76, 0.2)';
                ctx.lineWidth = 1;
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.moveTo(fx, pad.top);
                ctx.lineTo(fx, pad.top + chartH);
                ctx.stroke();
                ctx.setLineDash([]);

                // Dot
                ctx.beginPath();
                ctx.arc(fx, fy, 6, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(201, 168, 76, 1)';
                ctx.fill();
                ctx.beginPath();
                ctx.arc(fx, fy, 12, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(201, 168, 76, 0.15)';
                ctx.fill();

                // Label
                ctx.fillStyle = 'rgba(201, 168, 76, 0.9)';
                ctx.font = '600 12px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('🎯 FIRE en año ' + data[fireYearIdx].year, fx, fy - 20);
            }
        }

        // ===== YEARLY TABLE =====
        function updateYearlyTable() {
            const tbody = document.getElementById('yearlyBody');
            tbody.innerHTML = '';
            yearlyData.forEach(d => {
                const tr = document.createElement('tr');
                if (d.isFireYear) tr.className = 'fire-year';
                tr.innerHTML = `
                    <td>${d.year}</td>
                    <td>${d.age}</td>
                    <td class="positive">+${formatCurrency(d.contribution)}</td>
                    <td class="positive">+${formatCurrency(d.returnAmount)}</td>
                    <td>${formatCurrency(d.balance)}</td>
                    <td>${d.firePercent.toFixed(1)}%</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // ===== SCROLL REVEAL =====
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('visible');
            });
        }, { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // ===== INIT =====
        window.addEventListener('load', () => {
            updateCalc();
        });

        window.addEventListener('resize', () => {
            updateCalc();
        });
    </script>
</body>
</html>
