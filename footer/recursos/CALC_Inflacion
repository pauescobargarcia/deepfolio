    <!-- FOOTER -->
    <footer class="footer">
        <p>© 2025 <a href="#">deeptfolio</a> — Calculadora de Inflación · Los datos son estimaciones basadas en tasas históricas</p>
    </footer>

    <script>
        // ===== STATE =====
        let state = {
            amount: 10000,
            years: 10,
            rate: 4.0
        };

        // ===== FORMAT =====
        function formatCurrency(num) {
            return '€' + Math.round(num).toLocaleString('es-ES');
        }

        function formatNumber(num, decimals = 1) {
            return num.toFixed(decimals);
        }

        // ===== CALCULATE =====
        function calculate() {
            const amountInput = document.getElementById('initialAmount').value;
            // En formato español los puntos son separadores de miles, no decimales
            const amount = parseFloat(amountInput.replace(/\./g, '').replace(',', '.'));
            if (isNaN(amount)) return;

            const futureValue = amount / Math.pow(1 + state.rate / 100, state.years);
            const loss = amount - futureValue;
            const lossPct = (loss / amount) * 100;
            const doublingYears = 72 / state.rate;
            const totalDays = state.years * 365.25;
            const dailyLoss = loss / totalDays;

            // Animate result
            const resultEl = document.getElementById('resultValue');
            resultEl.textContent = formatCurrency(futureValue);
            resultEl.classList.remove('pulse');
            void resultEl.offsetWidth;
            resultEl.classList.add('pulse');

            document.getElementById('resultSubtitle').textContent = `en ${state.years} años`;
            document.getElementById('lossAmount').textContent = '-' + formatCurrency(loss);
            document.getElementById('lossPercent').textContent = '-' + formatNumber(lossPct) + '%';
            document.getElementById('halfLife').textContent = formatNumber(doublingYears) + ' años';
            document.getElementById('dailyLoss').textContent = '€' + formatNumber(dailyLoss, 2);

            drawChart(amount, futureValue, state.rate, state.years);
        }

        // ===== UPDATE SLIDERS =====
        function updateYears(val) {
            state.years = parseInt(val);
            document.getElementById('yearsDisplay').textContent = val + (val == 1 ? ' año' : ' años');
            calculate();
        }

        function updateRate(val) {
            state.rate = parseFloat(val);
            document.getElementById('rateDisplay').textContent = formatNumber(val, 1) + '%';
            calculate();
        }

        // ===== SCENARIOS =====
        function selectScenario(type, el) {
            document.querySelectorAll('.scenario-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');

            const rates = { conservative: 2, moderate: 4, aggressive: 8 };
            state.rate = rates[type];
            document.getElementById('rateSlider').value = rates[type];
            document.getElementById('rateDisplay').textContent = formatNumber(rates[type], 1) + '%';

            // Deselect country buttons
            document.querySelectorAll('.country-btn').forEach(b => b.classList.remove('active'));

            calculate();
        }

        // ===== COUNTRY =====
        function selectCountry(el, rate, code) {
            document.querySelectorAll('.country-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');

            state.rate = rate;
            document.getElementById('rateSlider').value = rate;
            document.getElementById('rateDisplay').textContent = formatNumber(rate, 1) + '%';

            // Deselect scenario cards
            document.querySelectorAll('.scenario-card').forEach(c => c.classList.remove('active'));

            calculate();
        }

        // ===== CHART =====
        function drawChart(initial, finalVal, rate, years) {
            const canvas = document.getElementById('inflationChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            ctx.scale(dpr, dpr);

            const w = rect.width;
            const h = rect.height;
            const pad = { top: 15, right: 15, bottom: 25, left: 15 };

            const points = years + 1;
            const data = [];
            for (let i = 0; i <= years; i++) {
                data.push(initial / Math.pow(1 + rate / 100, i));
            }

            const min = Math.min(...data) * 0.9;
            const max = Math.max(...data) * 1.05;

            function getX(i) { return pad.left + (i / (points - 1)) * (w - pad.left - pad.right); }
            function getY(v) { return pad.top + (1 - (v - min) / (max - min)) * (h - pad.top - pad.bottom); }

            // Grid
            ctx.strokeStyle = 'rgba(123, 45, 53, 0.08)';
            ctx.lineWidth = 0.5;
            for (let i = 0; i <= 4; i++) {
                const y = pad.top + (i / 4) * (h - pad.top - pad.bottom);
                ctx.beginPath();
                ctx.moveTo(pad.left, y);
                ctx.lineTo(w - pad.right, y);
                ctx.stroke();
            }

            // Gradient fill
            const gradient = ctx.createLinearGradient(0, pad.top, 0, h - pad.bottom);
            gradient.addColorStop(0, 'rgba(196, 90, 90, 0.15)');
            gradient.addColorStop(1, 'rgba(196, 90, 90, 0)');

            // Area
            ctx.beginPath();
            ctx.moveTo(getX(0), h - pad.bottom);
            for (let i = 0; i < points; i++) {
                if (i === 0) ctx.lineTo(getX(i), getY(data[i]));
                else {
                    const cx = (getX(i - 1) + getX(i)) / 2;
                    ctx.bezierCurveTo(cx, getY(data[i - 1]), cx, getY(data[i]), getX(i), getY(data[i]));
                }
            }
            ctx.lineTo(getX(points - 1), h - pad.bottom);
            ctx.closePath();
            ctx.fillStyle = gradient;
            ctx.fill();

            // Line
            ctx.beginPath();
            for (let i = 0; i < points; i++) {
                if (i === 0) ctx.moveTo(getX(i), getY(data[i]));
                else {
                    const cx = (getX(i - 1) + getX(i)) / 2;
                    ctx.bezierCurveTo(cx, getY(data[i - 1]), cx, getY(data[i]), getX(i), getY(data[i]));
                }
            }
            ctx.strokeStyle = 'rgba(196, 90, 90, 0.8)';
            ctx.lineWidth = 2.5;
            ctx.stroke();

            // Start dot
            ctx.beginPath();
            ctx.arc(getX(0), getY(data[0]), 4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(201, 168, 76, 0.9)';
            ctx.fill();

            // End dot
            ctx.beginPath();
            ctx.arc(getX(points - 1), getY(data[points - 1]), 4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(196, 90, 90, 0.9)';
            ctx.fill();

            // Labels
            ctx.font = '10px JetBrains Mono, monospace';
            ctx.fillStyle = 'rgba(245, 237, 228, 0.35)';
            ctx.textAlign = 'left';
            ctx.fillText(formatCurrency(data[0]), getX(0) - 5, getY(data[0]) - 10);
            ctx.textAlign = 'right';
            ctx.fillText(formatCurrency(data[points - 1]), getX(points - 1) + 5, getY(data[points - 1]) - 10);

            // X axis labels
            ctx.textAlign = 'center';
            const step = Math.max(1, Math.floor(years / 6));
            for (let i = 0; i <= years; i += step) {
                ctx.fillText(i + 'a', getX(i), h - 5);
            }
            ctx.fillText(years + 'a', getX(years), h - 5);
        }

        // ===== INPUT FORMATTING =====
        document.getElementById('initialAmount').addEventListener('input', function(e) {
            // Solo permitir dígitos y separadores mientras se escribe
            let pos = this.selectionStart;
            let raw = this.value.replace(/[^0-9]/g, '');
            if (raw === '') { this.value = ''; return; }

            // Contar dígitos antes del cursor antes de reformatear
            let digitsBefore = this.value.slice(0, pos).replace(/[^0-9]/g, '').length;

            let formatted = parseInt(raw).toLocaleString('es-ES');
            this.value = formatted;

            // Restaurar cursor: encontrar la posición después de los mismos dígitos
            let digits = 0;
            let newPos = 0;
            for (let i = 0; i < formatted.length; i++) {
                if (/[0-9]/.test(formatted[i])) digits++;
                if (digits === digitsBefore) { newPos = i + 1; break; }
            }
            this.setSelectionRange(newPos, newPos);
            calculate();
        });

        document.getElementById('initialAmount').addEventListener('blur', function() {
            let raw = this.value.replace(/[^0-9]/g, '');
            if (raw) {
                this.value = parseInt(raw).toLocaleString('es-ES');
            }
            calculate();
        });

        // ===== INIT =====
        window.addEventListener('load', () => {
            calculate();
        });

        window.addEventListener('resize', () => {
            calculate();
        });
    </script>
